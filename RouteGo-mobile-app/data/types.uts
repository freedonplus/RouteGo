/** 与后端 RouteVO / RouteDepartureVO / OrderVO 对齐的数据模型 */

export type Itinerary = {
	day: number
	title: string
	detail: string
}

export type Departure = {
	id: number
	departDate: string
	adultPrice: number
	childPrice: number
	remaining: number
}

export type RouteItem = {
	id: number
	title: string
	subtitle: string
	destination: string
	departureCity: string
	days: number
	nights: number
	minPrice: number
	originalPrice: number
	rating: number
	sales: number
	categoryName: string
	/** 封面图 URL，可能为空串 */
	coverImage: string
	/** 图集 URL 列表，可能为空 */
	images: string[]
	highlights: string
	includeItems: string
	excludeItems: string
	bookingNotice: string
	tags: string[]
	itineraries: Itinerary[]
	departures: Departure[]
}

export type OrderItem = {
	id: number
	orderNo: string
	routeTitle: string
	destination: string
	departDate: string
	travelerCount: number
	totalAmount: number
	discountAmount: number
	payAmount: number
	status: number
	statusDesc: string
	createTime: string
}

export type Category = {
	id: number
	name: string
	count: number
}

/** 我的券包条目 */
export type CouponItem = {
	id: number
	templateName: string
	/** 券类型描述，如「满减券」 */
	typeDesc: string
	/** 使用门槛，0 表示无门槛 */
	threshold: number
	/** 面额（满减券） */
	amount: number
	/** 折扣（折扣券），0 表示不适用 */
	discount: number
	/** 权益描述，如「满 1000 减 100」 */
	benefitDesc: string
	/** 0 未使用，1 已使用，2 已过期 */
	status: number
	statusDesc: string
	expired: boolean
	usable: boolean
	/** 有效期，形如 2026-12-31 */
	expireTime: string
	code: string
}
