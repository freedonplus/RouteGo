/** 与后端 RouteVO / RouteDepartureVO / OrderVO 对齐的数据模型 */

export type Itinerary = {
	day: number
	title: string
	detail: string
}

export type Departure = {
	id: number
	departDate: string
	adultPrice: number
	childPrice: number
	remaining: number
}

export type RouteItem = {
	id: number
	title: string
	subtitle: string
	destination: string
	departureCity: string
	days: number
	nights: number
	minPrice: number
	originalPrice: number
	rating: number
	sales: number
	categoryName: string
	/** 封面图 URL，可能为空串 */
	coverImage: string
	/** 图集 URL 列表，可能为空 */
	images: string[]
	highlights: string
	includeItems: string
	excludeItems: string
	bookingNotice: string
	tags: string[]
	itineraries: Itinerary[]
	departures: Departure[]
}

export type OrderItem = {
	id: number
	orderNo: string
	routeTitle: string
	destination: string
	departDate: string
	travelerCount: number
	totalAmount: number
	discountAmount: number
	payAmount: number
	status: number
	statusDesc: string
	createTime: string
}

export type Category = {
	id: number
	name: string
	count: number
}

/** 我的券包条目 */
export type CouponItem = {
	id: number
	templateName: string
	/** 券类型描述，如「满减券」 */
	typeDesc: string
	/** 使用门槛，0 表示无门槛 */
	threshold: number
	/** 面额（满减券） */
	amount: number
	/** 折扣（折扣券），0 表示不适用 */
	discount: number
	/** 权益描述，如「满 1000 减 100」 */
	benefitDesc: string
	/** 0 未使用，1 已使用，2 已过期 */
	status: number
	statusDesc: string
	expired: boolean
	usable: boolean
	/** 有效期，形如 2026-12-31 */
	expireTime: string
	code: string
}

/** 客服会话（对应后端 CsSessionVO） */
export type CsSession = {
	id: number
	ticketNo: string
	/** 1 售前，2 订单，3 退款，4 投诉，5 其他 */
	type: number
	typeDesc: string
	title: string
	/** 0 待处理，1 处理中，2 已解决，3 已关闭 */
	status: number
	statusDesc: string
	lastMessage: string
	lastMessageTime: string
	/** 客服回复后累加，进入会话清零 */
	unread: number
	/** 接待客服昵称，未指派为空串 */
	handlerName: string
}

/** 客服会话中的一条消息（对应后端 CsMessageVO） */
export type CsMessage = {
	id: number
	/** 1 客户，2 客服/系统 */
	senderType: number
	senderName: string
	content: string
	/** 已补全为绝对地址，可直接给 image 使用 */
	images: string[]
	createTime: string
}
