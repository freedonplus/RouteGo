/**
 * 环境配置。
 *
 * H5 端由 Vite 读取 .env / .env.development / .env.production 注入；
 * App 端（uni-app x 编译为原生）不经过 Vite，这里用条件编译给默认值。
 *
 * 三个优先级，从高到低：
 * 1. 本地存储覆盖 rg_api_base（真机调试临时改地址，不用重新编译）
 * 2. 条件编译默认值（H5 走 127.0.0.1，App 走局域网 IP）
 * 3. 生产域名兜底
 */

/** 本地存储键：接口地址覆盖值 */
export const KEY_API_BASE = 'rg_api_base'
/** 本地存储键：登录令牌 */
export const KEY_TOKEN = 'rg_token'
/** 本地存储键：会员信息 */
export const KEY_CUSTOMER = 'rg_customer'

/**
 * 后端接口根地址，末尾不带斜杠。
 */
export function getApiBaseUrl(): string {
	// 1. 运行时覆盖，方便真机换网络后调试
	const override = uni.getStorageSync(KEY_API_BASE)
	if (override != null) {
		const text = override.toString().trim()
		if (text.length > 0) {
			return text
		}
	}
	// 2. 条件编译默认值
	let base = 'https://api.routego.com/api'
	// #ifdef H5
	base = 'http://127.0.0.1:8080/api'
	// #endif
	// #ifdef APP
	// 真机 / 模拟器上 127.0.0.1 是手机自己，必须用电脑的局域网 IP
	base = 'http://10.20.10.248:8080/api'
	// #endif
	return base
}

/**
 * 是否允许接口失败时回退本地演示数据。
 * 生产环境必须为 false，避免把「接口挂了」伪装成「有数据」。
 */
export function enableMockFallback(): boolean {
	return false
}

/** 应用名，供启动页与关于页使用 */
export const APP_NAME = 'RouteGo'
/** 品牌标语 */
export const APP_SLOGAN = '发现值得走的风景'
