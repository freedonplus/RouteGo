<script setup lang="uts">
	import { prefetchHomeData } from './data/api.uts'
	import { warmUpTap } from './utils/feedback.uts'

	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
	// #endif

	onLaunch(() => {
		console.log('RouteGo launch')
		// 提前把点击音效实例建好，第一次点击就不会等音频加载
		warmUpTap()
		// 启动页停留的这 1 秒正好用来预取线路与分类：首页/线路页可直接用缓存渲染
		prefetchHomeData()
	})

	onAppShow(() => {
		console.log('RouteGo show')
	})

	onAppHide(() => {
		console.log('RouteGo hide')
	})

	// #ifdef APP-ANDROID || APP-HARMONY
	onLastPageBackPress(() => {
		if (firstBackTime == 0) {
			uni.showToast({
				title: '再按一次退出应用',
				position: 'bottom',
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			uni.exit()
		}
	})

	onExit(() => {
		console.log('RouteGo exit')
	})
	// #endif
</script>

<style>
	/* ============================================================
	   RouteGo Mobile —— Apple Style 设计系统
	   背景 #f5f5f7 / 强调 #0071e3 / 正文 #1d1d1f
	   无渐变、无重阴影、克制配色
	   说明：uvue 只支持类名选择器，页面背景统一由下方 .page-root 提供
	   ============================================================ */

	/*
	 * 页面骨架：page-root(flex:1) > scroll-view(flex:1) > page(内容)
	 * uni-app x 原生端页面自身不能滚动，必须在根节点放 scroll-view；
	 * 内层 .page 不能加 flex:1，否则高度被锁成视口高度、内容溢出后无法滚动。
	 */
	.page-root {
		flex: 1;
		background-color: #f5f5f7;
	}

	.page-scroll {
		flex: 1;
	}

	.page {
		background-color: #f5f5f7;
		padding-bottom: 28px;
	}

	.section {
		padding-left: 20px;
		padding-right: 20px;
	}

	/* ---------- 排版 ---------- */
	.h1 {
		font-size: 30px;
		font-weight: 600;
		color: #1d1d1f;
		letter-spacing: -0.6px;
		line-height: 38px;
	}

	.h2 {
		font-size: 21px;
		font-weight: 600;
		color: #1d1d1f;
		letter-spacing: -0.3px;
	}

	.h3 {
		font-size: 17px;
		font-weight: 600;
		color: #1d1d1f;
		letter-spacing: -0.2px;
	}

	.body {
		font-size: 15px;
		color: #1d1d1f;
		line-height: 22px;
	}

	.muted {
		font-size: 13px;
		color: #6e6e73;
		line-height: 19px;
	}

	.faint {
		font-size: 12px;
		color: #86868b;
	}

	/* ---------- 卡片 ---------- */
	.card {
		background-color: #ffffff;
		border-radius: 20px;
		padding: 20px;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
		transition-property: transform, opacity;
		transition-duration: 120ms;
		transition-timing-function: ease;
	}

	.card-tight {
		background-color: #ffffff;
		border-radius: 20px;
