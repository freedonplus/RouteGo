<template>
	<view class="page-root">
		<scroll-view class="page-scroll" style="flex:1">
			<view class="page" style="padding-bottom:96px">
				<view class="section" style="padding-top:16px">
					<text class="h1" style="font-size:26px">在线客服</text>
					<text class="muted" style="margin-top:8px">工作时间 9:00–21:00，非工作时间留言也会回复</text>
				</view>

				<view class="section" style="margin-top:16px">
					<view
						v-for="s in sessions"
						:key="s.id"
						class="card"
						style="margin-bottom:12px"
						hover-class="card-pressing" hover-start-time="0" hover-stay-time="60"
						@click="openChat(s)"
					>
						<view class="row-between">
							<view class="row" style="align-items:center;flex:1">
								<text class="h3" style="font-size:16px">{{ s.title }}</text>
								<view v-if="s.unread > 0" class="badge">
									<text class="badge-text">{{ unreadText(s.unread) }}</text>
								</view>
							</view>
							<text :class="statusClass(s.status)" style="margin-left:10px">{{ s.statusDesc }}</text>
						</view>

						<text class="faint" style="margin-top:8px">{{ previewText(s) }}</text>

						<view class="row-between" style="margin-top:12px">
							<text class="faint">{{ handlerText(s) }}</text>
							<text class="faint">{{ formatChatTime(s.lastMessageTime) }}</text>
						</view>
					</view>

					<view v-if="errorText.length > 0" class="card" style="margin-bottom:12px">
						<text class="body">{{ errorText }}</text>
						<view class="btn btn-secondary" style="margin-top:14px" hover-class="btn-pressing" hover-start-time="0" hover-stay-time="60" @click="retry">
							<text class="btn-secondary-text">重新加载</text>
						</view>
					</view>

					<view v-else-if="!loading && sessions.length == 0" class="card" style="align-items:center;padding-top:40px;padding-bottom:40px">
						<text class="h3">还没有咨询记录</text>
						<text class="muted" style="margin-top:8px;text-align:center">行程、订单、退款有问题，都可以直接问客服</text>
						<view class="btn btn-primary" hover-class="btn-pressing" hover-start-time="0" hover-stay-time="60" style="margin-top:20px;padding-left:28px;padding-right:28px" @click="goCreate">
							<text class="btn-primary-text">发起咨询</text>
						</view>
					</view>
				</view>
			</view>
		</scroll-view>

		<view class="footer">
			<view class="btn btn-primary" style="flex:1" hover-class="btn-pressing" hover-start-time="0" hover-stay-time="60" @click="goCreate">
				<text class="btn-primary-text">发起新咨询</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { fetchCsSessions, formatChatTime, isLoggedIn } from '../../data/api.uts'
	import type { CsSession } from '../../data/types.uts'
	import { tap } from '../../utils/feedback.uts'

	const sessions = ref<CsSession[]>([])
	const loading = ref<boolean>(true)
	const errorText = ref<string>('')

	function loadData() {
		if (!isLoggedIn()) {
			loading.value = false
			sessions.value = []
			errorText.value = '登录后可以查看与客服的对话记录'
			return
		}
		loading.value = true
		errorText.value = ''
		fetchCsSessions().then((list) => {
			loading.value = false
			sessions.value = list
		}).catch((e) => {
			loading.value = false
			sessions.value = []
			errorText.value = (e as Error).message
		})
	}

	function retry() {
		tap()
		loadData()
	}

	onShow(() => {
		loadData()
	})

	function previewText(s: CsSession): string {
		if (s.lastMessage.length > 0) {
			return s.lastMessage
		}
		return '暂无消息'
	}
	function handlerText(s: CsSession): string {
		if (s.handlerName.length > 0) {
			return '客服 ' + s.handlerName
		}
		return s.status == 3 ? '会话已结束' : '等待客服接入'
	}
	function unreadText(count: number): string {
		if (count > 99) {
			return '99+'
		}
		return count.toString()
	}
	function statusClass(status: number): string {
		if (status == 0) {
			return 'status status-pending'
		}
		if (status == 1) {
			return 'status status-processing'
		}
		if (status == 2) {
			return 'status status-done'
		}
		return 'status status-closed'
	}
	function openChat(s: CsSession) {
		tap()
		uni.navigateTo({ url: '/pages/cs/chat?id=' + s.id })
	}
	function goCreate() {
		tap()
		if (!isLoggedIn()) {
			uni.navigateTo({ url: '/pages/user/login' })
			return
		}
		uni.navigateTo({ url: '/pages/cs/create' })
	}
</script>

<style>
	.badge {
		min-width: 18px;
		height: 18px;
		border-radius: 9px;
		background-color: #ef4444;
		justify-content: center;
		align-items: center;
		padding-left: 4px;
		padding-right: 4px;
		margin-left: 6px;
	}

	.badge-text {
		font-size: 11px;
		color: #ffffff;
	}

	.status {
		font-size: 12px;
	}

	.status-pending {
		color: #b45309;
	}

	.status-processing {
		color: #0071e3;
	}

	.status-done {
		color: #15803d;
	}

	.status-closed {
		color: #86868b;
	}

	.footer {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		flex-direction: row;
		align-items: center;
		background-color: #ffffff;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: #e5e5ea;
		padding: 12px 20px;
	}
</style>
