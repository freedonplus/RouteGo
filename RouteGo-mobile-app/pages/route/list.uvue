<template>
	<view class="page-root">
		<scroll-view class="page-scroll" style="flex:1">
			<view class="page">
				<view class="section" style="padding-top:14px">
					<view class="row-between">
						<view class="col">
							<text class="h1" style="font-size:26px">全部线路</text>
							<text class="muted" style="margin-top:6px">{{ countText }}</text>
						</view>
					</view>

					<view class="chips-wrap">
						<view
							v-for="(f, index) in filters"
							:key="f"
							:class="index === activeFilter ? 'chip chip-active' : 'chip'"
							style="margin-right:8px;margin-bottom:8px"
							hover-class="chip-pressing"
							@click="activeFilter = index"
						>
							<text :class="index === activeFilter ? 'chip-text chip-text-active' : 'chip-text'">{{ f }}</text>
						</view>
					</view>
				</view>

				<view class="section" style="margin-top:8px">
					<view
						v-for="item in filtered"
						:key="item.id"
						class="card-tight route-row"
						style="margin-bottom:12px"
						@click="openDetail(item.id)"
					>
						<view class="row" style="align-items:flex-start">
							<view class="cover" style="width:96px;height:96px">
								<image v-if="item.coverImage.length > 0" class="cover-img" :src="item.coverImage" mode="aspectFill"></image>
								<text v-else class="cover-text" style="font-size:12px;letter-spacing:1px">{{ item.categoryName }}</text>
							</view>

							<view class="col" style="flex:1;margin-left:14px">
								<text class="h3" style="font-size:16px">{{ item.title }}</text>
								<text class="faint" style="margin-top:6px">{{ item.days }}天{{ item.nights }}晚 · {{ item.departureCity }}出发</text>
								<text class="faint" style="margin-top:4px">★ {{ item.rating }} · 已售 {{ item.sales }}</text>

								<view class="row-between" style="margin-top:10px">
									<view class="row" style="align-items:flex-end">
										<text class="price-symbol" style="font-size:13px">¥</text>
										<text class="price-value" style="font-size:19px;margin-left:2px">{{ item.minPrice }}</text>
										<text class="price-unit" style="margin-left:4px">起</text>
									</view>
									<text class="faint">›</text>
								</view>
							</view>
						</view>
					</view>

					<view v-if="errorText.length > 0" class="card" style="margin-bottom:12px">
						<text class="body">{{ errorText }}</text>
						<view class="btn btn-secondary" style="margin-top:14px" hover-class="btn-pressing" @click="loadData">
							<text class="btn-secondary-text">重新加载</text>
						</view>
					</view>

					<view v-else-if="!loading && filtered.length === 0" class="card" style="align-items:center;padding-top:36px;padding-bottom:36px">
						<text class="h3">没有符合条件的线路</text>
						<text class="muted" style="margin-top:8px">换个筛选条件，或者告诉我们你想去哪</text>
					</view>
				</view>

				<view style="height:24px"></view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import { fetchRoutes } from '../../data/api.uts'
	import type { RouteItem } from '../../data/types.uts'

	const filters: string[] = ['推荐', '3 天内', '4–6 天', '7 天以上', '价格从低到高']
	const activeFilter = ref<number>(0)
	const routes = ref<RouteItem[]>([])
	const loading = ref<boolean>(true)
	const errorText = ref<string>('')

	const filtered = computed((): RouteItem[] => {
		const list: RouteItem[] = []
		routes.value.forEach((item) => {
			const f = activeFilter.value
			if (f === 1 && item.days > 3) {
				return
			}
			if (f === 2 && (item.days < 4 || item.days > 6)) {
				return
			}
			if (f === 3 && item.days < 7) {
				return
			}
			list.push(item)
		})

		if (activeFilter.value === 4) {
			list.sort((a, b) => a.minPrice - b.minPrice)
		}
		return list
	})

	const countText = computed((): string => {
		if (loading.value) {
			return '正在加载…'
		}
		if (errorText.value.length > 0) {
			return '加载失败'
		}
		return '共 ' + filtered.value.length + ' 条可选'
	})

	onLoad(() => {
		loadData()
	})

	function loadData() {
		loading.value = true
		errorText.value = ''
		fetchRoutes('', '', 0, 1, 50).then((list) => {
			routes.value = list
			loading.value = false
		}).catch((e: Error) => {
			errorText.value = e.message
			routes.value = [] as RouteItem[]
			loading.value = false
		})
	}

	function openDetail(id: number) {
		uni.navigateTo({ url: '/pages/route/detail?id=' + id })
	}
</script>

<style>
	.chips-wrap {
		flex-direction: row;
		flex-wrap: wrap;
		margin-top: 14px;
	}

	.route-row {
		transition-property: opacity;
		transition-duration: 200ms;
	}
</style>
