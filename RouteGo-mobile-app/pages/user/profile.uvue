<template>
	<view class="page-root">
		<scroll-view class="page-scroll" style="flex:1">
			<view class="page">
				<!-- 用户卡 -->
				<view class="section" style="padding-top:16px">
					<view class="card">
						<view class="row-between">
							<view class="row">
								<view class="avatar">
									<text class="avatar-text">{{ avatarText }}</text>
								</view>
								<view class="col" style="margin-left:14px">
									<text class="h3">{{ displayName }}</text>
									<view class="row" style="margin-top:6px">
										<view class="level-tag">
											<text class="level-text">{{ loggedIn ? '会员' : '未登录' }}</text>
										</view>
										<text class="faint" style="margin-left:8px">{{ displayPhone }}</text>
									</view>
								</view>
							</view>
							<text class="faint" @click="onSwitchAccount">{{ loggedIn ? '退出 ›' : '登录 ›' }}</text>
						</view>

						<view class="divider" style="margin-top:18px;margin-bottom:16px"></view>

						<view class="row-between">
							<view class="stat">
								<text class="stat-value">3</text>
								<text class="stat-label">优惠券</text>
							</view>
							<view class="stat">
								<text class="stat-value">2</text>
								<text class="stat-label">待出行</text>
							</view>
							<view class="stat">
								<text class="stat-value">6</text>
								<text class="stat-label">收藏</text>
							</view>
							<view class="stat">
								<text class="stat-value">12</text>
								<text class="stat-label">足迹</text>
							</view>
						</view>
					</view>
				</view>

				<!-- 订单快捷 -->
				<view class="section" style="margin-top:20px">
					<view class="card" style="padding-top:16px;padding-bottom:16px">
						<view class="row-between">
							<text class="h3" @click="goOrders">我的订单</text>
							<text class="faint" @click="goOrders">全部 ›</text>
						</view>
						<view class="row-between" style="margin-top:16px">
							<view class="quick" @click="goOrders">
								<text class="quick-icon">¥</text>
								<text class="quick-label">待支付</text>
							</view>
							<view class="quick" @click="goOrders">
								<text class="quick-icon">✈</text>
								<text class="quick-label">待出行</text>
							</view>
							<view class="quick" @click="goOrders">
								<text class="quick-icon">✓</text>
								<text class="quick-label">已完成</text>
							</view>
							<view class="quick" @click="goOrders">
								<text class="quick-icon">↺</text>
								<text class="quick-label">退款</text>
							</view>
						</view>
					</view>
				</view>

				<!-- 功能列表 -->
				<view class="section" style="margin-top:20px">
					<view class="card" style="padding-top:0;padding-bottom:0">
						<view v-for="(row, index) in rows" :key="row.label" class="list-row" @click="onRow(row.label)">
							<view class="row-between list-inner">
								<text class="body">{{ row.label }}</text>
								<view class="row">
									<text class="faint" style="margin-right:8px">{{ row.hint }}</text>
									<text class="faint">›</text>
								</view>
							</view>
							<view v-if="index !== rows.length - 1" class="list-divider"></view>
						</view>
					</view>
				</view>

				<view class="section" style="margin-top:24px">
					<text class="faint" style="text-align:center">RouteGo v1.0.0 · 全国风景线路</text>
				</view>

				<view style="height:24px"></view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import { fetchMe, getSession, logout } from '../../data/api.uts'

	type Row = {
		label: string
		hint: string
	}

	const rows: Row[] = [
		{ label: '定制行程', hint: '24 小时出方案' },
		{ label: '优惠券', hint: '' },
		{ label: '常用出行人', hint: '' },
		{ label: '联系客服', hint: '9:00–21:00' },
		{ label: '设置', hint: '' }
	]

	const loggedIn = ref<boolean>(false)
	const nickname = ref<string>('')
	const phone = ref<string>('')

	const displayName = computed((): string => {
		if (!loggedIn.value) {
			return '点击登录'
		}
		if (nickname.value.length > 0) {
			return nickname.value
		}
		return 'RouteGo 会员'
	})

	const displayPhone = computed((): string => {
		if (!loggedIn.value) {
			return '登录后同步订单与券包'
		}
		if (phone.value.length > 0) {
			return phone.value
		}
		return '已登录'
	})

	const avatarText = computed((): string => {
		if (!loggedIn.value) {
			return '登'
		}
		if (nickname.value.length > 0) {
			return nickname.value.substring(0, 1)
		}
		return '我'
	})

	onShow(() => {
		const session = getSession()
		if (session == null) {
			loggedIn.value = false
			nickname.value = ''
			phone.value = ''
			return
		}
		loggedIn.value = true
		nickname.value = session!.nickname
		phone.value = session!.phone
		// 后台静默刷新一次，拿到最新昵称与手机号
		fetchMe().then((me) => {
			nickname.value = me.nickname
			phone.value = me.phone
		}).catch((e: Error) => {
		})
	})

	function goOrders() {
		uni.switchTab({ url: '/pages/order/list' })
	}

	function goLogin() {
		uni.navigateTo({ url: '/pages/user/login' })
	}

	function onSwitchAccount() {
		if (!loggedIn.value) {
			goLogin()
			return
		}
		uni.showModal({
			title: '退出登录',
			content: '退出后需要重新验证手机号才能查看订单',
			success: (res) => {
				if (res.confirm) {
					logout()
					loggedIn.value = false
					nickname.value = ''
					phone.value = ''
					uni.showToast({ title: '已退出登录', icon: 'none' })
				}
			}
		})
	}

	function onRow(label: string) {
		if (label === '定制行程') {
			uni.navigateTo({ url: '/pages/custom/apply' })
			return
		}
		if (!loggedIn.value) {
			goLogin()
			return
		}
		uni.showToast({ title: label + '待接入', icon: 'none' })
	}
</script>

<style>
	.avatar {
		width: 56px;
		height: 56px;
		border-radius: 28px;
		background-color: #1d1d1f;
		justify-content: center;
		align-items: center;
	}

	.avatar-text {
		font-size: 20px;
		color: #ffffff;
		font-weight: 600;
	}

	.level-tag {
		border-radius: 8px;
		background-color: #f5f5f7;
		padding-left: 8px;
		padding-right: 8px;
		padding-top: 3px;
		padding-bottom: 3px;
	}

	.level-text {
		font-size: 12px;
		color: #6e6e73;
	}

	.stat {
		flex: 1;
		flex-direction: column;
		align-items: center;
	}

	.stat-value {
		font-size: 20px;
		color: #1d1d1f;
		font-weight: 600;
	}

	.stat-label {
		font-size: 12px;
		color: #86868b;
		margin-top: 4px;
	}

	.quick {
		flex: 1;
		flex-direction: column;
		align-items: center;
	}

	.quick-icon {
		font-size: 18px;
		color: #0071e3;
	}

	.quick-label {
		font-size: 12px;
		color: #6e6e73;
		margin-top: 6px;
	}

	.list-row {
		flex-direction: column;
	}

	.list-inner {
		padding-top: 17px;
		padding-bottom: 17px;
	}

	.list-divider {
		height: 1px;
		background-color: #e5e5ea;
	}
</style>
