<template>
	<view class="page-root">
		<scroll-view class="page-scroll" style="flex:1">
			<view class="page">
				<!-- ==================== 表单 ==================== -->
				<view v-if="step === 'form'">
					<view class="section" style="padding-top:28px">
						<text class="h1">{{ heading }}</text>
						<text class="muted" style="margin-top:10px">{{ subheading }}</text>
					</view>

					<view class="section" style="margin-top:24px" v-if="mode !== 'register'">
						<view class="tab-bar">
							<view :class="mode === 'account' ? 'tab-item tab-item-on' : 'tab-item'" @click="switchMode('account')">
								<text :class="mode === 'account' ? 'tab-text tab-text-on' : 'tab-text'">账号登录</text>
							</view>
							<view :class="mode === 'code' ? 'tab-item tab-item-on' : 'tab-item'" @click="switchMode('code')">
								<text :class="mode === 'code' ? 'tab-text tab-text-on' : 'tab-text'">验证码登录</text>
							</view>
						</view>
					</view>

					<view class="section" style="margin-top:16px">
						<view class="card">
							<!-- 账号登录：一个输入框兼容手机号 / 用户名 -->
							<view v-if="mode === 'account'">
								<text class="field-label">手机号 / 用户名</text>
								<input
									class="input"
									style="margin-top:8px"
									v-model="account"
									type="text"
									maxlength="32"
									placeholder="手机号或用户名都能登录"
									placeholder-class="ph"
								/>

								<text class="field-label" style="margin-top:20px">密码</text>
								<input
									class="input"
									style="margin-top:8px"
									v-model="password"
									type="text"
									:password="true"
									maxlength="32"
									placeholder="请输入密码"
									placeholder-class="ph"
								/>
							</view>

							<!-- 验证码登录 -->
							<view v-if="mode === 'code'">
								<text class="field-label">手机号</text>
								<input
									class="input"
									style="margin-top:8px"
									v-model="phone"
									type="tel"
									maxlength="11"
									placeholder="请输入手机号"
									placeholder-class="ph"
								/>

								<text class="field-label" style="margin-top:20px">验证码</text>
								<view class="row" style="margin-top:8px">
									<input
										class="input"
										style="flex:1"
										v-model="code"
										type="tel"
										maxlength="6"
										placeholder="6 位验证码"
										placeholder-class="ph"
									/>
									<view
										:class="canSend ? 'code-btn code-btn-active' : 'code-btn'"
										style="margin-left:12px"
										@click="sendCode"
									>
										<text :class="canSend ? 'code-text code-text-active' : 'code-text'">{{ codeButtonText }}</text>
									</view>
								</view>
							</view>

							<!-- 注册 -->
							<view v-if="mode === 'register'">
								<text class="field-label">手机号</text>
								<input
									class="input"
									style="margin-top:8px"
									v-model="phone"
									type="tel"
									maxlength="11"
									placeholder="请输入手机号"
									placeholder-class="ph"
								/>

								<text class="field-label" style="margin-top:20px">验证码</text>
								<view class="row" style="margin-top:8px">
									<input
										class="input"
										style="flex:1"
										v-model="code"
										type="tel"
										maxlength="6"
										placeholder="6 位验证码"
										placeholder-class="ph"
									/>
									<view
										:class="canSend ? 'code-btn code-btn-active' : 'code-btn'"
										style="margin-left:12px"
										@click="sendCode"
									>
										<text :class="canSend ? 'code-text code-text-active' : 'code-text'">{{ codeButtonText }}</text>
									</view>
								</view>

								<text class="field-label" style="margin-top:20px">用户名（可选）</text>
								<input
									class="input"
									style="margin-top:8px"
									v-model="nickname"
									type="text"
									maxlength="20"
									placeholder="2-20 位，留空自动生成"
									placeholder-class="ph"
								/>

								<text class="field-label" style="margin-top:20px">设置密码</text>
								<input
									class="input"
									style="margin-top:8px"
									v-model="password"
									type="text"
									:password="true"
									maxlength="32"
									placeholder="6-32 位，用于下次登录"
									placeholder-class="ph"
								/>
							</view>

							<view
								:class="canSubmit ? 'btn btn-primary' : 'btn btn-disabled'"
								style="margin-top:24px"
								@click="submit"
							>
								<text class="btn-primary-text">{{ submitText }}</text>
							</view>

							<view class="row" style="justify-content:center;margin-top:16px" v-if="mode !== 'register'">
								<text class="faint">没有账号？</text>
								<text class="link-text" style="margin-left:4px" @click="switchMode('register')">立即注册</text>
							</view>
							<view class="row" style="justify-content:center;margin-top:16px" v-else>
								<text class="faint">已有账号？</text>
								<text class="link-text" style="margin-left:4px" @click="switchMode('account')">返回登录</text>
							</view>
						</view>
					</view>

					<view class="section" style="margin-top:16px">
						<view class="row" @click="toggleAgree">
							<view :class="agreed ? 'check check-on' : 'check'">
								<text v-if="agreed" class="check-mark">✓</text>
							</view>
							<text class="faint" style="margin-left:8px;flex:1">我已阅读并同意《用户协议》与《隐私政策》</text>
						</view>
					</view>

					<view class="section" style="margin-top:32px">
						<view class="divider"></view>
						<view class="row" style="justify-content:center;margin-top:20px">
							<text class="faint">其他登录方式</text>
						</view>
						<view class="btn btn-secondary" style="margin-top:14px" @click="wechatLogin">
							<text class="btn-secondary-text">微信登录</text>
						</view>
					</view>
				</view>

				<!-- ==================== 登录后补设密码 ==================== -->
				<view v-if="step === 'setpwd'">
					<view class="section" style="padding-top:28px">
						<text class="h1">设置登录密码</text>
						<text class="muted" style="margin-top:10px">已经用验证码登录成功。设一个密码，下次就能用手机号或用户名直接登录。</text>
					</view>

					<view class="section" style="margin-top:24px">
						<view class="card">
							<text class="field-label">新密码</text>
							<input
								class="input"
								style="margin-top:8px"
								v-model="newPassword"
								type="text"
								:password="true"
								maxlength="32"
								placeholder="6-32 位"
								placeholder-class="ph"
							/>

							<text class="field-label" style="margin-top:20px">确认密码</text>
							<input
								class="input"
								style="margin-top:8px"
								v-model="confirmPassword"
								type="text"
								:password="true"
								maxlength="32"
								placeholder="再输一次"
								placeholder-class="ph"
							/>

							<view
								:class="canSavePassword ? 'btn btn-primary' : 'btn btn-disabled'"
								style="margin-top:24px"
								@click="savePassword"
							>
								<text class="btn-primary-text">{{ saving ? '保存中' : '保存并进入' }}</text>
							</view>

							<view class="row" style="justify-content:center;margin-top:16px" @click="finish">
								<text class="faint">稍后再说</text>
							</view>
						</view>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import { loginByAccount, loginByCode, registerAccount, sendLoginCode, setLoginPassword } from '../../data/api.uts'
	import type { Session } from '../../data/api.uts'

	// form：填表；setpwd：验证码登录成功但账号还没密码，引导补设
	const step = ref<string>('form')
	// account：账号+密码（手机号/用户名二合一）；code：验证码；register：注册
	const mode = ref<string>('account')

	const account = ref<string>('')
	const phone = ref<string>('')
	const code = ref<string>('')
	const password = ref<string>('')
	const nickname = ref<string>('')
	const newPassword = ref<string>('')
	const confirmPassword = ref<string>('')

	const agreed = ref<boolean>(true)
	const countdown = ref<number>(0)
	const sending = ref<boolean>(false)
	const submitting = ref<boolean>(false)
	const saving = ref<boolean>(false)

	let timer: number = -1

	const heading = computed((): string => {
		if (mode.value === 'register') {
			return '注册 RouteGo'
		}
		return '登录 RouteGo'
	})
	const subheading = computed((): string => {
		if (mode.value === 'register') {
			return '验证码确认身份，设置密码后可用手机号或用户名登录'
		}
		if (mode.value === 'account') {
			return '手机号和用户名都能登录，忘了密码就切验证码'
		}
		return '用手机号接收验证码，未注册将自动创建账号'
	})
	const submitText = computed((): string => {
		if (mode.value === 'register') {
			return '注册并登录'
		}
		return '登录'
	})

	const canSend = computed((): boolean => phone.value.length === 11 && countdown.value === 0 && !sending.value)
	const codeButtonText = computed((): string => {
		if (sending.value) {
			return '发送中'
		}
		if (countdown.value > 0) {
			return countdown.value + 's'
		}
		return '获取验证码'
	})

	const canSubmit = computed((): boolean => {
		if (submitting.value) {
			return false
		}
		if (mode.value === 'account') {
			return account.value.length >= 4 && password.value.length >= 6
		}
		if (phone.value.length !== 11) {
			return false
		}
		if (code.value.length < 4) {
			return false
		}
		if (mode.value === 'register') {
			return password.value.length >= 6
		}
		return true
	})

	const canSavePassword = computed((): boolean => {
		return !saving.value && newPassword.value.length >= 6 && newPassword.value === confirmPassword.value
	})

	function switchMode(next: string) {
		if (submitting.value) {
			return
		}
		mode.value = next
		step.value = 'form'
	}

	function startCountdown() {
		countdown.value = 60
		if (timer !== -1) {
			clearInterval(timer)
		}
		timer = setInterval(() => {
			if (countdown.value <= 1) {
				countdown.value = 0
				clearInterval(timer)
				timer = -1
			} else {
				countdown.value = countdown.value - 1
			}
		}, 1000)
	}

	function sendCode() {
		if (phone.value.length !== 11) {
			uni.showToast({ title: '请输入 11 位手机号', icon: 'none' })
			return
		}
		if (countdown.value > 0 || sending.value) {
			return
		}
		sending.value = true
		sendLoginCode(phone.value).then((masked) => {
			sending.value = false
			uni.showToast({ title: '验证码已发送至 ' + masked, icon: 'none' })
			startCountdown()
		}).catch((e: Error) => {
			sending.value = false
			uni.showToast({ title: e.message, icon: 'none' })
		})
	}

	function toggleAgree() {
		agreed.value = !agreed.value
	}

	/** 登录成功后统一出口：没密码就先引导补设，避免下次密码登录进不来 */
	function afterLogin(session: Session) {
		submitting.value = false
		if (!session.hasPassword) {
			step.value = 'setpwd'
			uni.showToast({ title: '账号还没密码，先设一个', icon: 'none' })
			return
		}
		finish()
	}

	function finish() {
		submitting.value = false
		saving.value = false
		uni.showToast({ title: '登录成功', icon: 'success' })
		setTimeout(() => {
			uni.navigateBack()
		}, 600)
	}

	function onLoginError(e: Error) {
		submitting.value = false
		const msg = e.message
		uni.showToast({ title: msg, icon: 'none' })
		// 未设密码的账号：自动切到验证码登录，省得用户自己找
		if (msg.indexOf('尚未设置密码') >= 0) {
			password.value = ''
			mode.value = 'code'
		}
	}

	function submit() {
		if (submitting.value) {
			return
		}
		if (!agreed.value) {
			uni.showToast({ title: '请先同意用户协议', icon: 'none' })
			return
		}
		if (mode.value === 'account') {
			if (account.value.length < 4) {
				uni.showToast({ title: '请输入手机号或用户名', icon: 'none' })
				return
			}
			if (password.value.length < 6) {
				uni.showToast({ title: '请输入密码', icon: 'none' })
				return
			}
			submitting.value = true
			loginByAccount(account.value.trim(), password.value).then((session) => {
				afterLogin(session)
			}).catch((e: Error) => {
				onLoginError(e)
			})
			return
		}
		if (phone.value.length !== 11) {
			uni.showToast({ title: '请输入正确的手机号', icon: 'none' })
			return
		}
		if (code.value.length < 4) {
			uni.showToast({ title: '请输入验证码', icon: 'none' })
			return
		}
		submitting.value = true
		if (mode.value === 'register') {
			if (password.value.length < 6) {
				submitting.value = false
				uni.showToast({ title: '请设置 6 位以上密码', icon: 'none' })
				return
			}
			registerAccount(phone.value, code.value, password.value, nickname.value.trim()).then((session) => {
				afterLogin(session)
			}).catch((e: Error) => {
				submitting.value = false
				uni.showToast({ title: e.message, icon: 'none' })
			})
			return
		}
		loginByCode(phone.value, code.value).then((session) => {
			afterLogin(session)
		}).catch((e: Error) => {
			submitting.value = false
			uni.showToast({ title: e.message, icon: 'none' })
		})
	}

	function savePassword() {
		if (!canSavePassword.value) {
			uni.showToast({ title: '两次密码不一致或不足 6 位', icon: 'none' })
			return
		}
		saving.value = true
		setLoginPassword(newPassword.value).then((ok) => {
			saving.value = false
			uni.showToast({ title: '密码已设置', icon: 'success' })
			finish()
		}).catch((e: Error) => {
			saving.value = false
			uni.showToast({ title: e.message, icon: 'none' })
		})
	}

	function wechatLogin() {
		uni.showToast({ title: '微信登录待接入', icon: 'none' })
	}

	onUnload(() => {
		if (timer !== -1) {
			clearInterval(timer)
			timer = -1
		}
	})
</script>

<style>
	.ph {
		color: #86868b;
	}

	.field-label {
		font-size: 13px;
		color: #6e6e73;
	}

	.tab-bar {
		flex-direction: row;
		background-color: #f5f5f7;
		border-radius: 14px;
		padding: 4px;
	}

	.tab-item {
		flex: 1;
		height: 40px;
		border-radius: 11px;
		justify-content: center;
		align-items: center;
	}

	.tab-item-on {
		background-color: #ffffff;
	}

	.tab-text {
		font-size: 14px;
		color: #6e6e73;
	}

	.tab-text-on {
		color: #1d1d1f;
		font-weight: 600;
	}

	.link-text {
		font-size: 14px;
		color: #0071e3;
		font-weight: 500;
	}

	.code-btn {
		height: 48px;
		border-radius: 14px;
		background-color: #f5f5f7;
		padding-left: 16px;
		padding-right: 16px;
		justify-content: center;
		align-items: center;
	}

	.code-btn-active {
		background-color: #f0f7ff;
	}

	.code-text {
		font-size: 14px;
		color: #86868b;
	}

	.code-text-active {
		color: #0071e3;
		font-weight: 500;
	}

	.check {
		width: 20px;
		height: 20px;
		border-radius: 6px;
		border-width: 1px;
		border-style: solid;
		border-color: #d2d2d7;
		background-color: #ffffff;
		justify-content: center;
		align-items: center;
	}

	.check-on {
		background-color: #0071e3;
		border-color: #0071e3;
	}

	.check-mark {
		font-size: 12px;
		color: #ffffff;
		font-weight: 700;
	}
</style>
