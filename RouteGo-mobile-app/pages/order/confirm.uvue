<template>
	<view class="page-root">
		<scroll-view class="page-scroll" style="flex:1">
			<view class="page" style="padding-bottom:104px">
				<!-- 线路摘要 -->
				<view class="section" style="padding-top:16px">
					<view class="card">
						<view class="row" style="align-items:flex-start">
							<view class="cover" style="width:80px;height:80px">
								<image v-if="route.coverImage.length > 0" class="cover-img" :src="route.coverImage" mode="aspectFill"></image>
								<text v-else class="cover-text" style="font-size:11px;letter-spacing:1px">{{ route.categoryName }}</text>
							</view>
							<view class="col" style="flex:1;margin-left:14px">
								<text class="h3" style="font-size:16px">{{ route.title }}</text>
								<text class="faint" style="margin-top:6px">{{ departDate }} 出发 · {{ route.days }}天{{ route.nights }}晚</text>
								<text class="faint" style="margin-top:4px">{{ route.departureCity }} 集合</text>
							</view>
						</view>
					</view>
				</view>

				<!-- 人数 -->
				<view class="section" style="margin-top:20px">
					<text class="h3">出行人数</text>
					<view class="card" style="margin-top:10px">
						<view class="row-between" style="padding-bottom:14px">
							<view class="col">
								<text class="body">成人</text>
								<text class="faint" style="margin-top:3px">¥{{ departure.adultPrice }} / 人</text>
							</view>
							<view class="row">
								<view class="step-btn" @click="changeAdult(-1)">
									<text class="step-text">−</text>
								</view>
								<text class="step-value">{{ adultCount }}</text>
								<view class="step-btn" @click="changeAdult(1)">
									<text class="step-text">+</text>
								</view>
							</view>
						</view>

						<view class="divider"></view>

						<view class="row-between" style="padding-top:14px">
							<view class="col">
								<text class="body">儿童</text>
								<text class="faint" style="margin-top:3px">¥{{ departure.childPrice }} / 人</text>
							</view>
							<view class="row">
								<view class="step-btn" @click="changeChild(-1)">
									<text class="step-text">−</text>
								</view>
								<text class="step-value">{{ childCount }}</text>
								<view class="step-btn" @click="changeChild(1)">
									<text class="step-text">+</text>
								</view>
							</view>
						</view>
					</view>
				</view>

				<!-- 联系人 -->
				<view class="section" style="margin-top:20px">
					<text class="h3">联系人</text>
					<view class="card" style="margin-top:10px">
						<input class="input" v-model="contactName" placeholder="姓名" placeholder-class="ph" />
						<input class="input" style="margin-top:12px" v-model="contactPhone" type="tel" maxlength="11" placeholder="手机号" placeholder-class="ph" />
						<view class="row" style="margin-top:10px">
							<text class="faint">用于接收出行通知，请确保号码正确</text>
						</view>
					</view>
				</view>

				<!-- 优惠券 -->
				<view class="section" style="margin-top:20px">
					<text class="h3">优惠</text>
					<view class="card" style="margin-top:10px">
						<view class="row-between">
							<view class="col">
								<text class="body">新人立减券</text>
								<text class="faint" style="margin-top:3px">满 3000 可用，有效期至 11-30</text>
							</view>
							<view class="row">
								<text class="coupon-cut">−¥200</text>
								<text class="faint" style="margin-left:8px">›</text>
							</view>
						</view>
					</view>
				</view>

				<!-- 价格明细 -->
				<view class="section" style="margin-top:20px">
					<text class="h3">费用明细</text>
					<view class="card" style="margin-top:10px">
						<view class="row-between">
							<text class="muted">成人 × {{ adultCount }}</text>
							<text class="body">¥{{ adultAmount }}</text>
						</view>
						<view class="row-between" style="margin-top:12px">
							<text class="muted">儿童 × {{ childCount }}</text>
							<text class="body">¥{{ childAmount }}</text>
						</view>
						<view class="row-between" style="margin-top:12px">
							<text class="muted">优惠</text>
							<text class="body" style="color:#34c759">−¥{{ discount }}</text>
						</view>
						<view class="divider" style="margin-top:16px;margin-bottom:16px"></view>
						<view class="row-between">
							<text class="h3">合计</text>
							<text class="price-value" style="font-size:22px">¥{{ payAmount }}</text>
						</view>
					</view>
				</view>

				<view class="section" style="margin-top:16px">
					<text class="faint">提交即表示同意《预订须知》与《退改规则》。出发前 7 天可免费取消。</text>
				</view>

			</view>
		</scroll-view>
				<!-- 底部提交 -->
		<view class="footer">
			<view class="col">
				<view class="row" style="align-items:flex-end">
					<text class="price-symbol">¥</text>
					<text class="price-value" style="margin-left:2px">{{ payAmount }}</text>
				</view>
				<text class="faint" style="margin-top:2px">共 {{ totalTravelers }} 人</text>
			</view>
			<view class="btn btn-primary" style="padding-left:32px;padding-right:32px" @click="submit">
				<text class="btn-primary-text">提交订单</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import { createOrder, fetchDepartures, fetchRouteDetail, isLoggedIn } from '../../data/api.uts'
	import type { Departure, RouteItem } from '../../data/types.uts'

	const routeId = ref<number>(0)
	const departureId = ref<number>(0)
	const adultCount = ref<number>(2)
	const childCount = ref<number>(0)
	const contactName = ref<string>('')
	const contactPhone = ref<string>('')
	const discount = ref<number>(0)
	const submitting = ref<boolean>(false)
	const errorText = ref<string>('')
	const route = ref<RouteItem>(emptyRoute())

	const departure = computed((): Departure => {
		const list = route.value.departures
		if (list.length === 0) {
			return emptyDeparture()
		}
		let found: Departure = list[0]
		list.forEach((d) => {
			if (d.id === departureId.value) {
				found = d
			}
		})
		return found
	})

	const departDate = computed((): string => departure.value.departDate)
	const totalTravelers = computed((): number => adultCount.value + childCount.value)
	const adultAmount = computed((): number => adultCount.value * departure.value.adultPrice)
	const childAmount = computed((): number => childCount.value * departure.value.childPrice)
	const payAmount = computed((): number => adultAmount.value + childAmount.value - discount.value)

	onLoad((options) => {
		const r = options['routeId']
		if (r != null) {
			const parsed = parseInt(r.toString())
			if (parsed > 0) {
				routeId.value = parsed
			}
		}
		const d = options['departureId']
		if (d != null) {
			const parsed = parseInt(d.toString())
			if (parsed > 0) {
				departureId.value = parsed
			}
		}
		loadData()
	})

	function loadData() {
		if (routeId.value <= 0) {
			errorText.value = '缺少线路参数，请返回重新选择'
			return
		}
		fetchRouteDetail(routeId.value).then((detail) => {
			fetchDepartures(routeId.value).then((list) => {
				detail.departures = list
				route.value = detail
				if (departureId.value === 0 && list.length > 0) {
					departureId.value = list[0].id
				}
			}).catch((e: Error) => {
				route.value = detail
				errorText.value = e.message
			})
		}).catch((e: Error) => {
			errorText.value = e.message
		})
	}

	function emptyDeparture(): Departure {
		const d: Departure = { id: 0, departDate: '', adultPrice: 0, childPrice: 0, remaining: 0 }
		return d
	}

	function emptyRoute(): RouteItem {
		const r: RouteItem = {
			id: 0,
			title: '',
			subtitle: '',
			destination: '',
			departureCity: '',
			days: 0,
			nights: 0,
			minPrice: 0,
			originalPrice: 0,
			rating: 0,
			sales: 0,
			categoryName: '',
			coverImage: '',
			images: [] as string[],
			highlights: '',
			includeItems: '',
			excludeItems: '',
			bookingNotice: '',
			tags: [] as string[],
			itineraries: [],
			departures: [] as Departure[]
		}
		return r
	}

	function changeAdult(delta: number) {
		const next = adultCount.value + delta
		if (next >= 1 && next <= 9) {
			adultCount.value = next
		}
	}

	function changeChild(delta: number) {
		const next = childCount.value + delta
		if (next >= 0 && next <= 9) {
			childCount.value = next
		}
	}

	function submit() {
		if (submitting.value) {
			return
		}
		if (!isLoggedIn()) {
			uni.navigateTo({ url: '/pages/user/login' })
			return
		}
		if (contactName.value.length === 0) {
			uni.showToast({ title: '请填写联系人姓名', icon: 'none' })
			return
		}
		if (contactPhone.value.length !== 11) {
			uni.showToast({ title: '请填写正确的手机号', icon: 'none' })
			return
		}
		if (departureId.value === 0) {
			uni.showToast({ title: '该线路暂无可预订班期', icon: 'none' })
			return
		}
		submitting.value = true
		createOrder(routeId.value, departureId.value, totalTravelers.value, contactName.value, contactPhone.value, '').then((orderId) => {
			submitting.value = false
			uni.showToast({ title: '下单成功', icon: 'success' })
			setTimeout(() => {
				uni.redirectTo({ url: '/pages/order/detail?id=' + orderId })
			}, 800)
		}).catch((e: Error) => {
			submitting.value = false
			uni.showToast({ title: e.message, icon: 'none' })
		})
	}
</script>

<style>
	.ph {
		color: #86868b;
	}

	.step-btn {
		width: 32px;
		height: 32px;
		border-radius: 10px;
		background-color: #f5f5f7;
		justify-content: center;
		align-items: center;
	}

	.step-text {
		font-size: 18px;
		color: #1d1d1f;
	}

	.step-value {
		width: 44px;
		text-align: center;
		font-size: 16px;
		color: #1d1d1f;
		font-weight: 500;
	}

	.coupon-cut {
		font-size: 15px;
		color: #34c759;
		font-weight: 500;
	}

	.footer {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		background-color: #ffffff;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: #e5e5ea;
		padding: 12px 20px;
	}
</style>
