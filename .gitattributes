# 统一换行符，避免在 Windows 上提交的 shell 脚本到 Linux 服务器后报
# `/usr/bin/env: 'bash\r': No such file or directory`
* text=auto eol=lf

# 只能在 Windows 上跑的批处理保持 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制资源不做换行处理
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.jar  binary
*.zip  binary
