# 开发：npm run dev（真实后端，直接请求下面配置的地址）
# Mock：npm run dev:mock（内存数据）
# 生产：npm run build（读取 .env.production）
#
# 后端地址统一由 src/utils/api-base.js 从 VITE_API_BASE_URL 读取。

VITE_APP_ENV=development
VITE_USE_MOCK=false
# 后端接口前缀（浏览器直连，不走反向代理）
VITE_API_BASE_URL=http://localhost:8080/api
# 仅当 VITE_API_BASE_URL 写成 /api 时生效：npm run dev 时把 /api 代理到这里
VITE_PROXY_TARGET=http://localhost:8080
