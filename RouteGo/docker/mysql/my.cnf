# =============================================================================
# RouteGo · MySQL 8.0 生产配置片段
# 挂载到容器 /etc/mysql/conf.d/routego.cnf（官方镜像会自动 include）
# 需要按机器规格调整的项放在 compose 的 command 里，用 .env 里的变量控制，
# 这里只放「与业务正确性强相关、一般不用改」的设置。
# =============================================================================

[mysqld]
# 业务表全部 utf8mb4，避免昵称/地址里的 emoji 报 1366
character-set-server = utf8mb4
collation-server     = utf8mb4_general_ci

# 与 Java 侧、后端连接串保持同一时区，否则默认值写入的时间会差 8 小时
default-time-zone = '+08:00'

# 严格模式：截断/非法日期直接报错，而不是静默写脏数据
sql_mode = STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION

# 容器网络里全是 IP 访问，关掉反解省一次 DNS
skip-name-resolve

# 单条 SQL / 单包上限：批量发券、批量导出会用到
max_allowed_packet = 32M

# 慢查询：超过 1 秒记一条，出问题直接看 slow.log
slow_query_log      = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time     = 1
log_error_verbosity = 2

# 事务安全优先（金额、库存、券的状态流转都不允许丢事务）
innodb_flush_log_at_trx_commit = 1
innodb_file_per_table          = 1

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
