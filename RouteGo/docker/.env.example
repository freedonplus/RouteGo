# =============================================================================
# RouteGo 生产环境变量（复制为 .env 后使用）
#
#   cp .env.example .env && ./deploy.sh init
#
# 留空的密钥项会被 deploy.sh 自动填成随机值；下面带「必改」的项需要人工确认。
# .env 已被 .gitignore 忽略，不会被提交；不要把它拷进镜像或仓库。
# =============================================================================

# ---------- 基础 ----------
COMPOSE_PROJECT_NAME=routego
TZ=Asia/Shanghai
# 管理后台对外端口（前面还有一层 SLB/负载均衡时通常保持 80）
WEB_HTTP_PORT=80
# 后端映射到宿主机 127.0.0.1 的端口，仅用于本机排查
APP_PORT=8080
APP_IMAGE_TAG=latest

# JVM 参数：容器内存 2G 时 MaxRAMPercentage=75 约 1.5G 堆；小机器按比例自动收缩
# 注意：变量值里的 $ 需要写成 $$，否则会被 compose 当成变量插值
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:InitialRAMPercentage=40 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=routego
# 应用专用账号（不要用 root 跑业务）
MYSQL_USER=routego
MYSQL_PASSWORD=
MYSQL_MAX_CONNECTIONS=500
# InnoDB 缓冲池，建议给到机器内存的 50%~60%
MYSQL_INNODB_BUFFER_POOL=512M
# 宿主机映射端口（只绑 127.0.0.1）
MYSQL_PUBLISH_PORT=3307
# 应用侧连接池
DB_POOL_MIN_IDLE=10
DB_POOL_MAX_SIZE=30

# ---------- Redis ----------
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_MAXMEMORY=512mb

# ---------- MinIO 对象存储 ----------
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=routego
MINIO_CONSOLE_PORT=9001
# 控制台反向代理地址（直接用 IP:9001 访问可留空）
MINIO_BROWSER_REDIRECT_URL=

# ---------- 应用密钥（改完就不能再改，否则历史密文解不开） ----------
# AES：openssl rand -base64 32（base64 解码后 32 字节）
ROUTEGO_CRYPTO_AES_KEY=
# HMAC 盲索引密钥：openssl rand -hex 32
ROUTEGO_CRYPTO_HMAC_KEY=
# 文件临时预览链接签名：openssl rand -hex 24
ROUTEGO_TEMP_URL_SECRET=

# ---------- 安全 ----------
# 必改：允许访问接口的前端来源，逗号分隔，必须带协议和端口
# 例：https://admin.example.com,https://www.example.com
ROUTEGO_SECURITY_ALLOWED_ORIGINS=http://localhost
# 上 HTTPS 后保持 true；纯 HTTP 内网试运行时改成 false，否则浏览器不会回传登录 Cookie
SA_TOKEN_COOKIE_SECURE=true

# ---------- 短信 / IP 归属地（接口盒子 apihz） ----------
# 填好 ID/KEY 后改为 true，否则 C 端手机号验证码登录不可用
ROUTEGO_SMS_ENABLED=false
ROUTEGO_SMS_ID=
ROUTEGO_SMS_KEY=
ROUTEGO_IP_LOCATION_ENABLED=true

# ---------- 第三方登录（按需启用） ----------
# 后端公网地址，例如 https://api.example.com/api
ROUTEGO_OAUTH_BASE_URL=
ROUTEGO_OAUTH_SUCCESS_REDIRECT=
ROUTEGO_OAUTH_FAILURE_REDIRECT=

# ---------- 前端 ----------
VITE_API_BASE_URL=/api
